{
  "name": "davante-academy",
  "version": "1.0.0",
  "description": "Web de Davante Academy. El CSS se genera con SASS a partir de la carpeta scss/",
  "private": true,
  "scripts": {
    "build": "sass scss/main.scss styles.css --style=expanded --no-source-map --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function",
    "watch": "sass scss/main.scss styles.css --watch --style=expanded --no-source-map --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function"
  },
  "devDependencies": {
    "bootstrap": "5.3.2",
    "sass": "1.108.2"
  }
}


